{
  "name": "handelsrepublik",
  "version": "0.1.0",
  "description": "Unofficial TypeScript SDK for the Trade Republic web API.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "npm run build && node ./demo/repl.mjs",
    "start": "npm run build && node ./demo/repl.mjs",
    "build": "tsup src/index.ts --format esm --dts --sourcemap",
    "demo:repl": "npm run build && node ./demo/repl.mjs",
    "demo:tui": "npm run build && node ./demo/tui.mjs",
    "demo:scratchpad": "node --import tsx ./demo/scratchpad.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:integration": "node --import tsx --test tests/integration/*.test.ts",
    "ci:reauth": "node --import tsx scripts/reauth-ci.ts",
    "typecheck": "tsc --noEmit",
    "schemas:doc": "node --import tsx scripts/generate-schema-catalog.ts"
  },
  "keywords": [
    "handelsrepublik",
    "broker",
    "api",
    "sdk",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VIEWVIEWVIEW/handelsrepublik.git"
  },
  "bugs": {
    "url": "https://github.com/VIEWVIEWVIEW/handelsrepublik/issues"
  },
  "homepage": "https://github.com/VIEWVIEWVIEW/handelsrepublik#readme",
  "dependencies": {
    "@bufbuild/protobuf": "^2.12.1",
    "ws": "^8.18.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "playwright": "^1.61.1"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/blessed": "^0.1.27",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "acorn": "^8.17.0",
    "blessed": "^0.1.81",
    "jsqr": "^1.4.0",
    "playwright": "^1.61.1",
    "pngjs": "^7.0.0",
    "qrcode-terminal": "^0.12.0",
    "tsup": "^8.3.5",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3"
  }
}
