prefix_rule(
    pattern = ["gh", ["auth", "repo", "run", "workflow", "secret"]],
    decision = "allow",
    justification = "Allow this repository's CI management through the host-authenticated GitHub CLI.",
    match = [
        "gh auth status",
        "gh repo view --json nameWithOwner",
        "gh run list --limit 10",
        "gh run view 29468822669 --log-failed",
        "gh workflow run test.yml --ref main",
        "gh secret set TR_SESSION_JSON --env trade-republic-tests --repo VIEWVIEWVIEW/handelsrepublik",
    ],
    not_match = [
        "gh pr merge 123",
        "gh release create v1.0.0",
    ],
)
